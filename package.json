{
  "name": "zerowaste-ai-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm --prefix frontend/ui run dev",
    "dev:frontend:next": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "build:frontend": "npm --prefix frontend/ui run build",
    "build:backend": "npm --workspace backend run build",
    "test:backend": "npm --workspace backend run test",
    "lint:frontend": "npm --prefix frontend/ui run lint",
    "typecheck:frontend": "npm --prefix frontend/ui run typecheck"
  }
}
