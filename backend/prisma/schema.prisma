generator client {
  provider = "prisma-client-js"
}

model RecommendationRevision {
  id               String   @id @default(cuid())
  recommendationId String
  version          Int
  actor            String
  snapshot         Json
  createdAt        DateTime @default(now())

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@unique([recommendationId, version])
  @@index([recommendationId, createdAt])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InventoryStatus {
  FRESH
  WARNING
  CRITICAL
}

enum RecommendationStatus {
  DRAFT
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

enum ActionType {
  REPLENISH
  MARKDOWN
  TRANSFER
}

enum PlannerDecision {
  CREATED
  MODIFIED
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

model Store {
  id          String            @id @default(cuid())
  name        String
  region      String?
  timezone    String            @default("UTC")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  inventory   InventoryBatch[]
  sales       SalesRecord[]
  promotions  Promotion[]
  waste       WasteRecord[]
  forecasts   DemandForecast[]
  recommendations Recommendation[]
  externalContext ExternalContext[]
  receipts     Receipt[]

  @@index([name])
}

model Product {
  id          String            @id @default(cuid())
  sku         String            @unique
  name        String
  category    String
  unit        String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  inventory   InventoryBatch[]
  sales       SalesRecord[]
  forecasts   DemandForecast[]
  recommendations RecommendationAction[]
  proposals   Recommendation[]
  waste       WasteRecord[]
  promotions  Promotion[]
  receiptLines ReceiptLine[]
}

model InventoryBatch {
  id          String              @id @default(cuid())
  sourceId    String?             @unique
  storeId     String
  productId   String
  quantity    Int
  expiryDate  DateTime
  status      InventoryStatus     @default(FRESH)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  store       Store               @relation(fields: [storeId], references: [id])
  product     Product             @relation(fields: [productId], references: [id])
  spoilage    SpoilageRisk[]
  waste       WasteRecord[]
  receiptLines ReceiptLine[]

  @@index([storeId, productId])
  @@index([storeId, status, expiryDate])
  @@index([expiryDate])
}

model SalesRecord {
  id          String    @id @default(cuid())
  sourceId    String?   @unique
  storeId     String
  productId   String
  quantity    Int
  revenue     Decimal   @db.Decimal(12, 2)
  soldAt      DateTime
  createdAt   DateTime  @default(now())

  store       Store     @relation(fields: [storeId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@index([storeId, soldAt])
  @@index([productId, soldAt])
}

model Receipt {
  id          String     @id @default(cuid())
  sourceId    String?    @unique
  storeId     String
  supplierName String?
  orderDate   DateTime
  deliveredAt DateTime?
  totalCost   Decimal    @db.Decimal(12, 2)
  createdAt   DateTime   @default(now())

  store       Store     @relation(fields: [storeId], references: [id])
  lines       ReceiptLine[]

  @@index([storeId, orderDate])
}

model ReceiptLine {
  id          String    @id @default(cuid())
  receiptId   String
  productId   String
  batchId     String?
  quantity    Int
  unitCost    Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())

  receipt     Receipt        @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id])
  batch       InventoryBatch? @relation(fields: [batchId], references: [id])

  @@index([receiptId])
  @@index([productId])
}

model Promotion {
  id          String    @id @default(cuid())
  sourceId    String?   @unique
  storeId     String
  productId   String?
  name        String
  discountPct Decimal   @db.Decimal(5, 2)
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime  @default(now())

  store       Store     @relation(fields: [storeId], references: [id])
  product     Product?  @relation(fields: [productId], references: [id])

  @@index([storeId, startsAt])
}

model WasteRecord {
  id          String    @id @default(cuid())
  sourceId    String?   @unique
  storeId     String
  productId   String
  batchId     String?
  quantity    Int
  reason      String
  recordedAt  DateTime
  createdAt   DateTime  @default(now())

  store       Store     @relation(fields: [storeId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  batch       InventoryBatch? @relation(fields: [batchId], references: [id])

  @@index([storeId, recordedAt])
  @@index([productId, recordedAt])
}

model ExternalContext {
  id          String    @id @default(cuid())
  storeId     String
  contextType String
  eventName   String?
  observedAt  DateTime
  payload     Json?
  createdAt   DateTime  @default(now())

  store       Store     @relation(fields: [storeId], references: [id])

  @@index([storeId, observedAt])
}

model DemandForecast {
  id          String    @id @default(cuid())
  storeId     String
  productId   String
  forecastQty Decimal   @db.Decimal(12, 2)
  confidence  Decimal   @db.Decimal(5, 2)
  horizonDays Int
  generatedAt DateTime
  modelVersion String?
  createdAt   DateTime  @default(now())

  store       Store     @relation(fields: [storeId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@index([storeId, generatedAt])
  @@index([productId, generatedAt])
  @@index([generatedAt])
}

model SpoilageRisk {
  id          String        @id @default(cuid())
  batchId     String
  riskScore   Decimal       @db.Decimal(5, 2)
  riskLevel   String
  daysToExpiry Int
  generatedAt DateTime
  modelVersion String?
  createdAt   DateTime      @default(now())

  batch       InventoryBatch @relation(fields: [batchId], references: [id])

  @@index([batchId, generatedAt])
}

model Recommendation {
  id          String                 @id @default(cuid())
  storeId     String
  productId   String
  actionType  ActionType
  status      RecommendationStatus   @default(DRAFT)
  confidence  Decimal                @db.Decimal(5, 2)
  quantity    Int?
  reason      String
  evidence   String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  store       Store                  @relation(fields: [storeId], references: [id])
  product     Product                @relation(fields: [productId], references: [id])
  actions     RecommendationAction[]
  decisions   PlannerDecisionRecord[]
  execution   ExecutionRecord?
  revisions   RecommendationRevision[]
  auditLogs   AuditLog[]

  @@index([storeId, status])
  @@index([createdAt])
}

model RecommendationAction {
  id                  String    @id @default(cuid())
  recommendationId    String
  productId           String
  actionType          ActionType
  targetStoreId       String?
  quantity            Int?
  markdownPercent     Decimal?  @db.Decimal(5, 2)
  createdAt           DateTime  @default(now())

  recommendation      Recommendation @relation(fields: [recommendationId], references: [id])
  product             Product        @relation(fields: [productId], references: [id])

  @@index([recommendationId])
}

model PlannerDecisionRecord {
  id               String       @id @default(cuid())
  recommendationId String
  actor            String
  decision         PlannerDecision
  notes            String?
  createdAt        DateTime     @default(now())

  recommendation   Recommendation @relation(fields: [recommendationId], references: [id])

  @@index([recommendationId, createdAt])
}

model ExecutionRecord {
  id               String       @id @default(cuid())
  recommendationId String       @unique
  status           String
  payload          Json?
  failureReason    String?
  executedAt       DateTime     @default(now())

  recommendation   Recommendation @relation(fields: [recommendationId], references: [id])

  @@index([recommendationId, executedAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  recommendationId String?
  actor          String
  action         String
  entityType     String
  entityId       String
  details        Json?
  createdAt      DateTime      @default(now())

  recommendation Recommendation? @relation(fields: [recommendationId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model EvaluationRun {
  id          String    @id @default(cuid())
  metricName  String
  metricValue Decimal   @db.Decimal(10, 4)
  baselineValue Decimal? @db.Decimal(10, 4)
  notes       String?
  generatedAt DateTime  @default(now())

  @@index([metricName, generatedAt])
}
