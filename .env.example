# Root workspace example
# Copy into each service as `.env` if required.
# Frontend should never receive production secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_MOCK_MODE=true

# Backend
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/zerowaste_ai?schema=public
JWT_SECRET=replace_with_secure_key
ML_SERVICE_URL=http://localhost:8000

# ML service
ML_PORT=8000
MODEL_ENV=development
